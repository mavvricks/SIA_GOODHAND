{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@prototype/ui-tokens": ["./packages/ui-tokens/index.ts"],
      "@prototype/ui": ["./packages/ui/index.ts"],
      "@prototype/logger": ["./packages/logger/index.ts"],
      "@prototype/contract": ["./packages/contract/index.ts"]
    }
  },
  "exclude": ["node_modules"]
}
