# shared
# Local SQLite is stored in the repository .data directory (requires Node 24+).
# Optional override: GOODHAND_DATA_DIR=C:/absolute/path/to/data
# Postgres URL examples below are reserved for the later hosted-adapter migration.
NODE_ENV=development
LOG_LEVEL=debug
DEMO_MODE=true

# store
STORE_DATABASE_URL=postgres://user:pass@localhost:5432/store_db
STORE_TEST_DATABASE_URL=postgres://user:pass@localhost:5432/store_test
STORE_PUBLIC_URL=http://localhost:3000
STORE_SESSION_SECRET=change_me_session_secret_at_least_64_characters_long_for_security_compliance
STORE_FSM_BASE_URL=http://localhost:3100/api/v1
STORE_SERVICE_CLIENT_ID=store-service
STORE_SERVICE_CLIENT_SECRET=change_me_store_service_secret_at_least_32_characters
STORE_WEBHOOK_SIGNING_SECRET=change_me_webhook_signing_secret_at_least_32_characters
CRON_SECRET_STORE=change_me_cron_secret_store_at_least_32_characters
INSTALLATION_INTEGRATION_ENABLED=true
REQUIRE_EMAIL_VERIFICATION=false

# fsm
FSM_DATABASE_URL=postgres://user:pass@localhost:5432/fsm_db
FSM_TEST_DATABASE_URL=postgres://user:pass@localhost:5432/fsm_test
FSM_PUBLIC_URL=http://localhost:3100
FSM_SESSION_SECRET=change_me_session_secret_at_least_64_characters_long_for_security_compliance
FSM_STORE_BASE_URL=http://localhost:3000/api/v1
FSM_SERVICE_CLIENT_ID=fsm-service
FSM_SERVICE_CLIENT_SECRET=change_me_fsm_service_secret_at_least_32_characters
FSM_WEBHOOK_SIGNING_SECRET=change_me_webhook_signing_secret_at_least_32_characters
CRON_SECRET_FSM=change_me_cron_secret_fsm_at_least_32_characters

# email (Resend; leave empty to use the in-app mail log)
RESEND_API_KEY=
MAIL_FROM=no-reply@secservice-demo.xyz

# policy
HTTP_CONNECT_TIMEOUT_MS=2000
HTTP_READ_TIMEOUT_MS=5000
RETRY_MAX_ATTEMPTS=5
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=30
FEEDBACK_WINDOW_DAYS=30
FEEDBACK_EDIT_DAYS=7
CUSTOMER_CANCEL_MIN_HOURS_BEFORE=24
CUSTOMER_MAX_RESCHEDULES=2
