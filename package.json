{
  "name": "goodhand-prototype-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.x"
  },
  "description": "GoodHand Store + Field Service Integration Prototype",
  "scripts": {
    "db:init": "node scripts/local-database.mjs init",
    "db:status": "node scripts/local-database.mjs status",
    "db:backup": "node scripts/local-database.mjs backup",
    "clone-site": "node scripts/clone-site.mjs",
    "contract:lint": "pnpm --filter @prototype/contract lint",
    "contract:generate": "pnpm --filter @prototype/contract generate",
    "build": "pnpm --filter @prototype/store build && pnpm --filter @prototype/fsm build",
    "dev": "pnpm --parallel --filter=./apps/* dev",
    "demo:reset": "node scripts/reset-demo.mjs",
    "test": "vitest run",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yaml}\"",
    "db:migrate": "node scripts/postgres-database.mjs migrate",
    "db:import-local": "node scripts/postgres-database.mjs import-local",
    "db:cloud-status": "node scripts/postgres-database.mjs status",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
